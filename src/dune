(library
 (name utils)
 (modules utils)
 (preprocess
  (pps lwt_ppx ppx_deriving_yojson))
 (libraries dream batteries malloc timedesc re2))

; Tutto frontend/dist (la build di Vite: pubblico e bo) alla radice del filesystem statico.
; cp -a dist/* non copia .vite/, che Dream non deve servire.

(rule
 (target static_filesystem.ml)
 (deps
  (glob_files_rec %{project_root}/frontend/dist/*))
 (action
  (progn
   (bash
    "rm -Rf %{project_root}/static_filesystem && mkdir %{project_root}/static_filesystem")
   (bash
    "cp -a %{project_root}/frontend/dist/* %{project_root}/static_filesystem/")
   (with-stdout-to
    %{target}
    (run ocaml-crunch -m plain %{project_root}/static_filesystem)))))
