{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codegen": "graphql-codegen --config codegen.ts && tsr generate",
    "lint:classi": "bash scripts/controlla-classi.sh src && bash scripts/controlla-link-bo.sh src",
    "typecheck": "bun run codegen && tsc -b",
    "build": "bun run lint:classi && bun run codegen && vite build && bun scripts/controlla-ingresso.ts",
    "lint": "oxlint",
    "test": "TZ=Europe/Rome bun test src/lib/excel",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "graphql": "^16.15.0",
    "graphql-request": "^7.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
